# ============================================================
# KL Project — Production Environment Variables Template
#
# This template defines the environment variables required for
# production deployment on Railway (api-server) and Vercel (web-app).
#
# DO NOT commit actual values. Set these directly in:
#   - Railway: Project → Service → Variables
#   - Vercel:  Project → Settings → Environment Variables
# ============================================================

# ----------------------------------------------------------------
# 🚂 RAILWAY (api-server) — Required
# ----------------------------------------------------------------

# PostgreSQL connection (use Supabase pooler URL for serverless-friendly pooling)
DATABASE_URL=postgresql://USER:PASS@db.PROJECT.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT secrets — MUST be unique, ≥ 32 random chars each
# Generate: openssl rand -base64 48
JWT_SECRET=
REFRESH_TOKEN_SECRET=
CUSTOMER_JWT_SECRET=

# Token lifetimes
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=30d

# Cookie / CORS
# COOKIE_DOMAIN should be a leading-dot apex (e.g., .kl-project.com) so
# subdomains share the auth cookie.
COOKIE_DOMAIN=.kl-project.com

# Comma-separated list of allowed origins (web-app + admin + Vercel preview if used)
ALLOWED_ORIGINS=https://app.kl-project.com,https://admin.kl-project.com

# Server
# Railway injects PORT automatically; do NOT hardcode unless overriding.
NODE_ENV=production
ENABLE_DEV_ROUTES=false

# ----------------------------------------------------------------
# ▲ VERCEL (web-app) — Required
# ----------------------------------------------------------------

# Public Railway URL of the api-server (set after Railway deploys)
VITE_API_URL=https://api.kl-project.com
VITE_SOCKET_URL=https://api.kl-project.com

# Locale defaults
VITE_DEFAULT_LOCALE=en-MY
VITE_DEFAULT_CURRENCY=MYR

# ----------------------------------------------------------------
# Optional integrations (set only if used)
# ----------------------------------------------------------------
WHATSAPP_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
TELEGRAM_BOT_TOKEN=
