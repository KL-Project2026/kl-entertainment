# ============================================================
# KL Project — Environment Variables Template
# Copy to .env and fill in values before running locally.
# NEVER commit .env to version control.
# ============================================================

# === API Server (Railway) ===
DATABASE_URL=postgresql://USER:PASS@db.PROJECT.pooler.supabase.com:6543/postgres?pgbouncer=true
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-32-chars
REFRESH_TOKEN_EXPIRY=30d
# Customer portal uses a separate JWT secret (OPERATIONS_WORKFLOW.md §13).
# MUST differ from JWT_SECRET in production.
CUSTOMER_JWT_SECRET=change-me-customer-secret-min-32-chars
COOKIE_DOMAIN=.klproject.com
ALLOWED_ORIGINS=https://app.klproject.com,https://admin.klproject.com,http://localhost:5173
PORT=8080
NODE_ENV=development

# === Web App (Vercel) ===
VITE_API_URL=http://localhost:8080
VITE_SOCKET_URL=http://localhost:8080
VITE_DEFAULT_LOCALE=en-MY
VITE_DEFAULT_CURRENCY=MYR

# === Optional: Notifications ===
WHATSAPP_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
TELEGRAM_BOT_TOKEN=

# === Optional: Feature Flags ===
ENABLE_DEV_ROUTES=false
