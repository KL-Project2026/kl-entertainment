modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
JWT_SECRET = "kl-project-jwt-secret-min-32-chars-secure-2026"
REFRESH_TOKEN_SECRET = "kl-project-refresh-secret-secure-2026-xyz"
JWT_EXPIRY = "24h"
REFRESH_TOKEN_EXPIRY = "30d"
BASE_CURRENCY = "MYR"
DEFAULT_TIMEZONE = "Asia/Kuala_Lumpur"
DEFAULT_LANG = "en"
DISPLAY_CURRENCIES = "MYR,AUD,KRW,JPY,CNY"
